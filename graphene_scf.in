&CONTROL
  calculation = 'scf',
  prefix      = 'graphene',
  outdir      = './temp',
  pseudo_dir  = './',
  forc_conv_thr = 1.0d-4,      ! Strict force convergence for accurate phonons
  etot_conv_thr = 1.0d-5,
/

&SYSTEM
  ibrav     = 4,
  celldm(1) = 4.654,
  celldm(3) = 6.5,             ! Increased vacuum to isolate the 2D layer
  nat  = 2,
  ntyp = 1,
  ecutwfc = 120.0,
  ecutrho = 400.0,
  occupations = 'smearing',
  smearing = 'gaussian',
  degauss = 0.01,
/

&ELECTRONS
  conv_thr = 1.0d-10           ! Tighten convergence for subsequent phonon runs
/

&IONS
/

&CELL
  cell_dofree = '2Dxy'         ! Restricts relaxation to the flat plane only
/

ATOMIC_SPECIES
  C  12.0107 C_ONCV_PBE-1.2.upf

ATOMIC_POSITIONS (alat)
C                0.0000000000        0.0000000000        0.0000000000
C                0.0000000000        0.5773503000        0.0000000000

K_POINTS automatic
  24 24 1   0 0 0
